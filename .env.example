# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or local)
MONGO=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/verity?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string in production
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Server
PORT=3000
NODE_ENV=development

# Frontend origin allowed by CORS (Vite dev server default shown)
CORS_ORIGIN=http://localhost:5173

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Firebase Web API key for Google sign-in (client/src/firebase.js).
# IMPORTANT: this is a Vite build-time variable, not a runtime one —
# Vite inlines VITE_* vars into the JS bundle when `npm run build` runs.
# Get this from Firebase Console -> Project Settings -> General -> Web API Key
# (project: blog-mern-24541, per the hardcoded config in firebase.js).
# For Docker builds, this must be passed as a --build-arg (see Dockerfile);
# on Railway, set it as a service Variable and it will be auto-forwarded
# as a build ARG since the Dockerfile declares ARG VITE_FIREBASE_API_KEY.
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
