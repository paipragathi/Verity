# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas or local)
MONGO=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/verity?retryWrites=true&w=majority

# Secret used to sign JWTs — use a long random string in production
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Server
PORT=3000
NODE_ENV=development

# Frontend origin allowed by CORS (Vite dev server default shown)
CORS_ORIGIN=http://localhost:5173

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
